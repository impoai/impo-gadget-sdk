menu "Camera"

    # A parallel (DVP) sensor driven by esp32-camera (camera_dvp.c): the
    # ESP-SparkBot's and the Freenove 4WD car's. Always defined, unlike a
    # bool that is off, so idf_component.yml's rules can pull in esp32-camera
    # and esp_new_jpeg on these boards only.
    config CAMERA_DRIVER
        string
        default "dvp" if IMPO_BOARD_ESPRESSIF_SPARKBOT || HOMEHUB_LED_BACKEND_FREENOVE_4WD_CAR
        default "none"

    config CAMERA_DVP
        bool
        default y if CAMERA_DRIVER = "dvp"

endmenu
