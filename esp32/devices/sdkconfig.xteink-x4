# Original Xteink X4: ESP32-C3, 16 MB, no PSRAM, SSD1677.
# Native USB Serial/JTAG 303a:1001. Load after sdkconfig.defaults.
# Reference: FreeInk commit 111fdcc7f0176c3ee38391a160ee296bf492dbd8,
# BoardConfig.h XTEINK_X4 and InputManager ADC ladder; see xteink_x4.c.
# Experimental: no SD reader, audio, touch, battery telemetry or automatic sleep.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HOMEHUB_LED_BACKEND_XTEINK_X4=y
CONFIG_HOMEHUB_BUTTON_GPIO=1
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-X4"
CONFIG_SPIRAM=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Keep the existing factory layout; see devices/XTEINK_X4.md for initial flash.
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_xteink_x4.csv"
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
# Development/recovery: no one-way eFuse changes or signed-app requirement.
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=n
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=n
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_NVS_ENCRYPTION=n
CONFIG_HOMEHUB_SUPPORT_BUG_REPORT=n
# The unused factory coredump data partition holds the custom power-off image.
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ABORTS=y
# SRAM budget follows the existing ESP32-C3 AI Passport control-only profile.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=8
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
