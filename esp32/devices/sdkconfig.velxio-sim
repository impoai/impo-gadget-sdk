# velxio-sim: a test board that exists only in the Velxio emulator
# (https://github.com/davidmonterocrespo24/velxio), which runs a classic ESP32
# in QEMU. It is the ideaspark board (classic ESP32, 16 MB flash, no PSRAM,
# 170x320 ST7789 on SPI2, BOOT on GPIO0) with the emulator's network. Load
# last, after sdkconfig.defaults and sdkconfig.ideaspark (see
# velxio-sim.md in this directory).
#
# Only settings that differ from the real ideaspark belong here, so the
# firmware under test stays the one that ships. The emulator needs a QEMU
# with Velxio's ESP32 fixes for chip revision 3.0 and the PHY clock register;
# without them the bootloader rejects the image and the PHY init asserts.

# Advertise as <prefix>-Sim-XXXXXX so it is never mistaken for a real board.
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Sim"

# The emulator has no Bluetooth radio, so the board can't be set up over BLE.
# Join Velxio's emulated open access point at boot instead. The device tokens
# go into NVS before boot (tools/velxio/make_flash.sh).
CONFIG_HOMEHUB_WIFI_SSID="Velxio-GUEST"
CONFIG_HOMEHUB_WIFI_PASSWORD=""
