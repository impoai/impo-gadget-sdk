# Keeps the device connected to its Impo. Runs as root (Bluetooth, device
# credentials); commands run as IMPOGADGET_RUN_AS, which the installer sets
# to the account that installed the device.

[Unit]
Description=Impo Home Link (Linux Device SDK)
Wants=network-online.target
After=network-online.target bluetooth.target

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=IMPOGADGET_RUN_AS=@RUN_AS@
ExecStart=/opt/impogadget/venv/bin/impogadget run
RuntimeDirectory=impogadget
RuntimeDirectoryMode=0755
StateDirectory=impogadget
StateDirectoryMode=0700
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
